{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "theo-apples",
	"compatibility_date": "2025-08-04",
	"main": "./worker/index.ts",
	"assets": {
		"not_found_handling": "single-page-application",
		"binding": "ASSETS"
	},
	"d1_databases": [		
		{
			"binding": "theo_apples_db",
			"database_name": "theo-apples-db",
			"database_id": "4cd56bcd-579a-4377-a2cf-ec3188697fed"
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "theo-apples-media"
		}
	],
	"vars": {
		"PUBLIC_SITE_URL": "http://localhost:3010"
	}
}